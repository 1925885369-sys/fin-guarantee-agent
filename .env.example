LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
RETRIEVAL_MODEL_DIR=.models/bge-base-zh-v1.5
RETRIEVAL_CHUNK_MAX_TOKENS=384
RETRIEVAL_CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_EXTRACT_QUERY_LIMIT=120
POLICY_PROFILE=bond-v1
LLM_INPUT_PRICE_PER_M=2
LLM_OUTPUT_PRICE_PER_M=8
MAX_RUN_MODEL_COST_CNY=2
MAX_RUN_MODEL_CALLS=40
LLM_BATCH_MAX_CHARS=24000
LLM_EXTRACT_BATCH_MAX_SOURCES=3
LLM_EXTRACT_MAX_BATCHES=16
LLM_EXTRACT_SOURCES_PER_TOPIC=2
LLM_DOWNSTREAM_RESERVED_CALLS=12
LLM_EXTRACT_MAX_COST_RATIO=0.6
LLM_MAX_OUTPUT_TOKENS=5000
# 报告章节的单次输出额度，独立于上面的通用上限（篇幅由章节 Prompt 的目标字数决定）。
LLM_REPORT_MAX_OUTPUT_TOKENS=10000
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=10
LLM_LATENCY_ANOMALY_SECONDS=90
LLM_DISABLE_THINKING=true
APP_DATA_DIR=.data
PUBLIC_DEMO=false
ALLOW_REAL_REFERENCE_EXPORT=false
MAX_FILES=8
MAX_FILE_MB=15
# Complete prospectuses commonly exceed 150 pages; parsing remains bounded by
# MAX_FILE_MB and MAX_TOTAL_CHARS.
MAX_PAGES=600
MAX_TOTAL_CHARS=300000
MAX_ZIP_ENTRIES=3000
MAX_ZIP_UNCOMPRESSED_MB=120
OCR_ENABLED=false
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
OCR_MAX_PAGES=30
RETENTION_HOURS=24
